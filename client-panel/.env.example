# API base URL (production build + dev proxy target)
VITE_API_URL=http://localhost:3001

# Dev server port (optional, default 5173)
# VITE_DEV_PORT=5173

# Pincode lookup API (fallback: https://api.postalpincode.in)
# VITE_PINCODE_API_URL=https://api.postalpincode.in

# Logo.dev config (get your token at https://logo.dev)
VITE_LOGO_DEV_BASE_URL=https://img.logo.dev



# Sentry (only active in production builds)
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
